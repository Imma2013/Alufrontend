# ===========================================
# ALU BACKEND - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)

# ===========================================
# DATABASE
# ===========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/alu?retryWrites=true&w=majority

# ===========================================
# AUTHENTICATION (Clerk)
# ===========================================
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# ===========================================
# AI SERVICES
# ===========================================
# Google Gemini (for NanoBanana image gen + prompt cleaning)
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxx

# Third-party video API (Sora, etc.) - optional for v1
THIRD_PARTY_API_URL=https://api.example.com/generate
THIRD_PARTY_API_KEY=xxxxxxxxxxxxx

# ===========================================
# PAYMENTS (Stripe)
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ===========================================
# ANALYTICS (PostHog)
# ===========================================
POSTHOG_API_KEY=phc_xxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# ===========================================
# APP CONFIG
# ===========================================
PORT=5000
FRONTEND_URL=https://your-frontend.vercel.app
NODE_ENV=development

# ===========================================
# AT PROTOCOL (Bluesky / PDS)
# ===========================================
ATPROTO_PDS_URL=https://bsky.social
ATPROTO_IDENTIFIER=your-handle-or-email
ATPROTO_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Optional override. If omitted, DID from login session is used.
ATPROTO_REPO_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
ATPROTO_ADMIN_KEY=change-me-before-prod
AUTH_TOKEN_SECRET=change-me-long-random-secret

# ===========================================
# STORJ (S3 COMPATIBLE OBJECT STORAGE)
# ===========================================
STORJ_S3_ENDPOINT=https://gateway.storjshare.io
STORJ_S3_REGION=global
STORJ_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxx
STORJ_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STORJ_BUCKET=alu-media
STORJ_PUBLIC_BASE_URL=https://link.storjshare.io/raw/your-bucket
